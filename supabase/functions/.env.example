# Segredos das Edge Functions (local: supabase functions serve --env-file supabase/functions/.env)
# Produção/homologação: `supabase secrets set --env-file ...` a partir do cofre — nunca versionar.
APP_ENV=local
DV_BACKEND_DB_URL=postgresql://dv_backend:dv_backend_local@host.docker.internal:54322/postgres
DV_ADMIN_DB_URL=postgresql://dv_admin_backend:dv_admin_local@host.docker.internal:54322/postgres
# Local: tokens são emitidos com este issuer; em nuvem deixar vazio (usa SUPABASE_URL/auth/v1).
DV_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
# Segredo HS256 do CLI local (tokens legados HS256). Tokens ES256/RS256 são sempre verificados via JWKS.
DV_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
DV_CRON_SECRET=local-cron-secret
DV_ADMIN_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# JSON da conta de serviço Firebase em uma linha; vazio = push simulado (log).
FCM_SERVICE_ACCOUNT_JSON=
