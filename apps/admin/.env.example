# Painel administrativo — somente valores PÚBLICOS (nunca a service role).
# Copie para .env.local (não versionado). Local: valores do `supabase status`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=<chave publicável/anon do projeto>
# Opcional: padrão = ${VITE_SUPABASE_URL}/functions/v1/admin
VITE_ADMIN_API_URL=
# Rótulo exibido no topo (local | staging | production)
VITE_DV_ENVIRONMENT=local
