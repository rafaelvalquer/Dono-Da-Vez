# Copie para .env (não versionado). Valores reais ficam no cofre de cada ambiente.

# ---- Públicas (podem ir para o app Android) ----
APP_ENV=local                        # local | staging | production
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=            # chave publicável/anon do projeto
MAP_STYLE_URL=                       # URL do estilo MapLibre do fornecedor de tiles contratado
MAP_PUBLIC_KEY=                      # chave pública restrita do fornecedor de mapas

# ---- Segredos (somente backend, CI e importador) ----
DV_BACKEND_DB_URL=postgresql://dv_backend:CHANGE_ME@127.0.0.1:54322/postgres
DV_IMPORTER_DB_URL=postgresql://dv_importer:CHANGE_ME@127.0.0.1:54322/postgres
DV_JWT_SECRET=                       # apenas local/legado HS256; vazio = JWKS do projeto
DV_CRON_SECRET=                      # segredo compartilhado entre pg_cron e outbox-worker
FCM_SERVICE_ACCOUNT_JSON=            # JSON da conta de serviço Firebase (string)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres   # testes locais
